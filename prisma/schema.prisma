// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String    @id @default(uuid())
  edrpou      String    @unique
  name        String?
  region      String?
  locality    String?

  tendersAsCustomer    Tender[]    @relation("TenderCustomer")
  contractsAsSupplier  Contract[]  @relation("ContractSupplier")
  bidsAsBidder         Bid[]       @relation("BidBidder")
  complaintsAuthored   Complaint[] @relation("ComplaintAuthor")

  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([region])
}

model Tender {
  id           String        @id
  tenderID     String?       // Public ID, e.g., UA-2025-01-01-000107-a
  title        String?
  description  String?
  status       String?
  amount                Float?
  currency              String?
  valueAddedTaxIncluded Boolean?
  year             Int           // To filter by 2025/2026
  dateModified     DateTime
  dateCreated      DateTime?

  // Official Prozorro periods
  tenderPeriodStart    DateTime?
  tenderPeriodEnd      DateTime?
  enquiryPeriodStart   DateTime?
  enquiryPeriodEnd     DateTime?
  auctionPeriodStart   DateTime?
  awardPeriodStart     DateTime?

  mainProcurementCategory String?  // goods, services, works
  procurementMethod       String?  // limited, open, selective
  procurementMethodType   String?  // reporting, belowThreshold, aboveThreshold, etc.

  syncStatus       String        @default("FULL") // "FULL", "PARTIAL", "FAILED", "RETRYING"

  // Denormalized customer fields (for fast reads without JOIN)
  customerEdrpou   String?
  customerName     String?
  customerRegion   String?
  customerLocality String?

  // FK to Company
  customerId       String?
  customer         Company?      @relation("TenderCustomer", fields: [customerId], references: [id])

  // Relations
  contracts        Contract[]
  lots             Lot[]
  bids             Bid[]
  complaints       Complaint[]

  @@index([customerEdrpou])
  @@index([tenderID])
  @@index([year])
  @@index([status])
  @@index([dateModified])
  @@index([syncStatus])
  @@index([mainProcurementCategory])
  @@index([procurementMethod])
  @@index([procurementMethodType])
  @@index([customerRegion])
  @@index([tenderPeriodStart])
  @@index([tenderPeriodEnd])
  @@index([enquiryPeriodStart])
  @@index([enquiryPeriodEnd])
  @@index([auctionPeriodStart])
  @@index([awardPeriodStart])
  @@index([year, dateModified])
  @@index([customerId])
}

model Contract {
  id                      String        @id
  contractID              String?       // Public ID
  contractNumber          String?       // Internal contract number
  description             String?
  status                  String?
  amount                  Float?
  currency                String?
  valueAddedTaxIncluded   Boolean?
  amountNet               Float?
  dateSigned              DateTime?
  date                    DateTime?
  dateModified            DateTime?
  dateCreated             DateTime?
  periodStartDate         DateTime?     // Contract execution period
  periodEndDate           DateTime?

  // Denormalized supplier fields
  supplierEdrpou          String?
  supplierName            String?

  // FK to Company
  supplierId              String?
  supplier                Company?      @relation("ContractSupplier", fields: [supplierId], references: [id])

  tenderId                String
  tender                  Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  items                   Item[]
  priceAnalyses           PriceAnalysis[]

  @@index([supplierEdrpou])
  @@index([contractID])
  @@index([contractNumber])
  @@index([tenderId])
  @@index([status])
  @@index([dateModified])
  @@index([dateSigned])
  @@index([periodEndDate])
  @@index([tenderId, supplierEdrpou])
  @@index([supplierId])
}

model Item {
  id                      String        @id
  description             String?
  quantity                Float?
  unitName                String?       // "штука", "кг", "послуга"
  unitCode                String?       // H87, KGM, etc.
  classificationId        String?       // ДК021 code, e.g. "18130000-9"
  classificationDescription String?
  deliveryRegion          String?
  deliveryLocality        String?

  contractId              String
  contract                Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([classificationId])
  @@index([contractId])
}

model Lot {
  id                      String        @id
  title                   String?
  description             String?
  status                  String?
  amount                  Float?
  currency                String?
  valueAddedTaxIncluded   Boolean?

  tenderId                String
  tender                  Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([status])
}

model Bid {
  id                      String        @id
  date                    DateTime?
  status                  String?
  amount                  Float?
  currency                String?
  valueAddedTaxIncluded   Boolean?

  // Denormalized bidder fields
  bidderEdrpou            String?
  bidderName              String?

  // FK to Company
  bidderId                String?
  bidder                  Company?      @relation("BidBidder", fields: [bidderId], references: [id])

  tenderId                String
  tender                  Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([bidderEdrpou])
  @@index([status])
  @@index([bidderId])
}

model Complaint {
  id                      String        @id
  title                   String?
  description             String?
  status                  String?       // claim, answered, resolved, declined, etc.
  type                    String?       // complaint, claim
  dateSubmitted           DateTime?
  complaintID             String?       // Public complaint ID

  // Complaint author
  complainantEdrpou       String?
  complainantName         String?

  // FK to Company (author)
  complainantId           String?
  complainant             Company?      @relation("ComplaintAuthor", fields: [complainantId], references: [id])

  tenderId                String
  tender                  Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([status])
  @@index([complainantEdrpou])
  @@index([complainantId])
}

model SyncState {
  id          Int      @id @default(1)
  lastOffset  String?
  updatedAt   DateTime @updatedAt
}

model PriceAnalysis {
  id                  String              @id @default(uuid())
  contractId          String
  contract            Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  status              String              @default("PENDING") // PENDING, DOWNLOADING_PDF, EXTRACTING_ITEMS, SEARCHING_PRICES, COMPLETE, FAILED
  errorMessage        String?
  totalItems          Int?
  itemsAboveMarket    Int?
  riskScore           Float?              // 0.0–1.0
  sourceDocumentTitle String?
  telegramChatId      String?             // Chat to send results back to
  telegramMessageId   Int?                // Status message to edit
  extractedItems      PriceAnalysisItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([riskScore])
}

model PriceAnalysisItem {
  id             String        @id @default(uuid())
  analysisId     String
  analysis       PriceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  itemName       String
  unitPrice      Float
  quantity       Float?
  unit           String?
  marketPrice    Float?
  marketPriceMin Float?
  marketPriceMax Float?
  marketSource   String?
  priceDeviation Float?        // (unitPrice - marketPrice) / marketPrice

  @@index([analysisId])
}
