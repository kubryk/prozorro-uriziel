POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=prozorro
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password_here

# Set to MAIN for the primary server with HTTP API / dashboard / Telegram bot
# Set to WORKER for queue-only processing without HTTP server or Telegram bot
APP_ROLE=MAIN

# Speed config for workers
WORKER_CONCURRENCY=50
WORKER_REQUESTS_PER_SECOND=50
WORKER_LOCK_DURATION_MS=300000
WORKER_DB_CONCURRENCY=2
MAIN_QUEUE_FAILED_JOBS_TO_KEEP=1000

# Start syncing from this date if no offset is saved (ISO date or Prozorro offset string)
SYNC_START_DATE=2025-01-01

# CORS origin (comma-separated for multiple, or * for dev)
CORS_ORIGIN=http://localhost:3000

# API Authentication Key
API_KEY=your_secure_api_key_for_bot_and_dashboard

# Public URL of this app (used to generate links in Telegram messages)
APP_URL=https://your-domain.com

# Telegram Bot (optional — bot won't start if token is empty or APP_ROLE=WORKER)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Google Gemini AI (required for price analysis)
GEMINI_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Price analysis worker concurrency (default: 3)
PRICE_ANALYSIS_CONCURRENCY=3
